<UserControl x:Class="PixivTools.Views.RandomPicTab"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PixivTools.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="关键词" Width="40" VerticalAlignment="Center" FontSize="12"
                              Foreground="{StaticResource Text2Brush}"/>
                    <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                            Width="240" Margin="8,0,0,0" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="标签" Width="40" VerticalAlignment="Center" FontSize="12"
                              Foreground="{StaticResource Text2Brush}"/>
                    <TextBox Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                            Width="240" Margin="8,0,0,0" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="R-18" IsChecked="{Binding IsNsfw}" VerticalAlignment="Center"
                             Margin="40,0,12,0" FontSize="12"/>
                    <Button Content="碰碰运气" Command="{Binding RandomCommand}"
                            Style="{StaticResource Btn}" Width="80" Height="26" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="作品信息" FontWeight="SemiBold" FontSize="12"
                              Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="PID" FontSize="10" Foreground="{StaticResource Text3Brush}"/>
                    <TextBlock Text="{Binding DisplayPid}" FontSize="12" Margin="0,1,0,8"/>
                    <TextBlock Text="标题" FontSize="10" Foreground="{StaticResource Text3Brush}"/>
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="12" Margin="0,1,0,8" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="作者" FontSize="10" Foreground="{StaticResource Text3Brush}"/>
                    <TextBlock Text="{Binding DisplayAuthor}" FontSize="12" Margin="0,1,0,8"/>
                    <TextBlock Text="标签" FontSize="10" Foreground="{StaticResource Text3Brush}"/>
                    <TextBlock Text="{Binding DisplayTags}" FontSize="11" Margin="0,1,0,8" TextWrapping="Wrap" MaxHeight="40"/>
                    <TextBlock Text="日期" FontSize="10" Foreground="{StaticResource Text3Brush}"/>
                    <TextBlock Text="{Binding DisplayDate}" FontSize="12" Margin="0,1,0,8"/>
                    <CheckBox Content="AI" IsEnabled="{Binding IsAiGenerated}" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                <controls:ImagePreview Source="{Binding ImageSource}"
                                      PlaceholderText="{Binding StatusText}"
                                      IsLoading="{Binding IsLoading}"/>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="打开" Command="{Binding OpenPictureRCommand}" IsEnabled="{Binding HasImage}"
                    Style="{StaticResource Btn2}" Width="60" Height="26" Margin="0,0,4,0" FontSize="11"/>
            <Button Content="保存" Command="{Binding SavePictureRCommand}" IsEnabled="{Binding HasImage}"
                    Style="{StaticResource Btn}" Width="60" Height="26" Margin="0,0,4,0" FontSize="11"/>
            <Button Content="刷新" Command="{Binding ReloadPictureRCommand}" IsEnabled="{Binding HasImage}"
                    Style="{StaticResource Btn2}" Width="60" Height="26" FontSize="11"/>
        </StackPanel>
    </Grid>
</UserControl>
