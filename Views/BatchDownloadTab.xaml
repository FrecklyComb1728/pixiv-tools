<UserControl x:Class="PixivTools.Views.BatchDownloadTab"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="PID" VerticalAlignment="Center" FontSize="12"
                          Foreground="{StaticResource Text2Brush}" Margin="0,0,6,0"/>
                <TextBox Text="{Binding InputPid, UpdateSourceTrigger=PropertyChanged}"
                        Width="180" FontSize="12" Padding="6,4" Margin="0,0,6,0"/>
                <Button Content="+" Command="{Binding AddPidCommand}" Style="{StaticResource Btn}"
                        Width="28" Height="26" Padding="0" FontSize="14" Margin="0,0,4,0"/>
                <Button Content="-" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource Btn2}"
                        Width="28" Height="26" Padding="0" FontSize="14" Margin="0,0,4,0"/>
                <Button Content="X" Command="{Binding ClearAllCommand}" Style="{StaticResource Btn2}"
                        Width="28" Height="26" Padding="0" FontSize="12"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                                    Padding="8,5" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="{Binding Pid}" IsChecked="{Binding IsSelected}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11"
                                              Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="1" Background="{StaticResource HoverBrush}" Padding="10,8"
                        CornerRadius="0,0,5,5" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <ProgressBar Value="{Binding ProgressValue}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                  Foreground="{StaticResource Text2Brush}"/>
                        <TextBlock Text="{Binding DownloadStats}" FontSize="10"
                                  Foreground="{StaticResource Text3Brush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="开始下载" Command="{Binding StartDownloadCommand}"
                    Style="{StaticResource BtnGreen}" Width="120" Height="28" FontSize="12"/>
            <Button Content="取消" Command="{Binding CancelDownloadCommand}"
                    Style="{StaticResource Btn2}" Width="80" Height="24" Margin="0,6,0,0" FontSize="11"/>
        </StackPanel>
    </Grid>
</UserControl>
