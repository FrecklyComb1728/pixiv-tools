<UserControl x:Class="PixivTools.Views.SettingsTab"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Cookie" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock Text="登录后可访问受限内容" FontSize="11"
                              Foreground="{StaticResource Text3Brush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Cookie, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,0,8,0" FontSize="11"/>
                        <Button Grid.Column="1" Content="登录 Pixiv" Command="{Binding LoginCommand}"
                                Style="{StaticResource Btn}" Height="28" VerticalAlignment="Top" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="PID 查图" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="格式" Width="48" VerticalAlignment="Center" FontSize="12"
                                  Foreground="{StaticResource Text2Brush}"/>
                        <RadioButton Content="PNG" GroupName="PicType" Margin="0,0,10,0" Checked="OnPicTypeChanged" Tag="png"/>
                        <RadioButton Content="JPG" GroupName="PicType" Margin="0,0,10,0" Checked="OnPicTypeChanged" Tag="jpg"/>
                        <RadioButton Content="GIF" GroupName="PicType" Checked="OnPicTypeChanged" Tag="gif"/>
                    </StackPanel>
                    <CheckBox Content="使用镜像域名" IsChecked="{Binding Mirror}" Margin="0,4,0,3"/>
                    <CheckBox Content="记录查询历史" IsChecked="{Binding Remember}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="预下载" Width="64" VerticalAlignment="Center" FontSize="12"
                                  Foreground="{StaticResource Text2Brush}"/>
                        <TextBox Text="{Binding PreDownloadCount, UpdateSourceTrigger=PropertyChanged}"
                                Width="50" FontSize="12" Padding="4,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="代理" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <CheckBox Content="启用代理" IsChecked="{Binding ProxyEnabled}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="类型" VerticalAlignment="Center" FontSize="12"
                                  Foreground="{StaticResource Text2Brush}" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ProxyTypes}"
                                 SelectedItem="{Binding ProxyType}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="2" Text="地址" VerticalAlignment="Center" FontSize="12"
                                  Foreground="{StaticResource Text2Brush}" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding ProxyAddr, UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="批量下载" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="格式" Width="48" VerticalAlignment="Center" FontSize="12"
                                  Foreground="{StaticResource Text2Brush}"/>
                        <RadioButton Content="PNG" GroupName="DlPicType" Margin="0,0,10,0" Checked="OnDlPicTypeChanged" Tag="png"/>
                        <RadioButton Content="JPG" GroupName="DlPicType" Margin="0,0,10,0" Checked="OnDlPicTypeChanged" Tag="jpg"/>
                        <RadioButton Content="GIF" GroupName="DlPicType" Checked="OnDlPicTypeChanged" Tag="gif"/>
                    </StackPanel>
                    <CheckBox Content="自动建文件夹" IsChecked="{Binding AutoFolder}" Margin="0,4,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="路径" VerticalAlignment="Center" FontSize="12"
                                  Foreground="{StaticResource Text2Brush}" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="打开配置目录" Command="{Binding OpenConfigDirCommand}"
                    Style="{StaticResource Btn2}" HorizontalAlignment="Left" FontSize="11"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
