<Window x:Class="PixivTools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pixiv Tools" Width="1130" Height="800" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Resources/logo.png">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,18,14,16">
                    <Image Source="pack://application:,,,/Resources/logo.png" Width="32" Height="32" Stretch="Uniform"/>
                </StackPanel>

                <ListBox x:Name="NavListBox" Margin="4,0,4,0" SelectedIndex="0"
                        SelectionChanged="OnNavSelectionChanged"
                        Background="Transparent" BorderThickness="0">
                    <ListBoxItem Padding="8,7" Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F50D;" FontSize="12" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="PID 查图" FontSize="12"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="8,7" Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F3B2;" FontSize="12" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="随机图" FontSize="12"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="8,7" Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4E6;" FontSize="12" Width="22" TextAlignment="Center"/>
                            <TextBlock Text="批量下载" FontSize="12"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="8,7" Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2699;" FontSize="12" Width="22" TextAlignment="Center"/>
                            <TextBlock Text=" 设置" FontSize="12"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Padding="8,7" Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2139;" FontSize="12" Width="22" TextAlignment="Center"/>
                            <TextBlock Text=" 关于" FontSize="12"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="16"/>
    </Grid>
</Window>
